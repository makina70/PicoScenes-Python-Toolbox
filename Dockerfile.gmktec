FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    WATCH_DIR=/data/csi \
    PATTERN=*.csi \
    API_URL=http://127.0.0.1:8001/csi \
    API_FORMAT=legacy \
    LEGACY_SERIES=pc1PhaseDiff \
    SAMPLING_RATE=100.0 \
    BASELINE_SECONDS=5.0 \
    SMOOTH_SECONDS=0.5 \
    MAX_TONES=256 \
    CHUNK_MB=32 \
    BATCH_SIZE=500 \
    STABLE_SECONDS=2.0 \
    POLL_INTERVAL=1.0 \
    FOLLOW_GROWING_FILES=true \
    FOLLOW_LAG_BYTES=1048576 \
    STREAM_READ_MB=32 \
    STREAM_POST_INTERVAL=1.0 \
    CLEANUP_ENABLED=true \
    MAX_CSI_DIR_GB=20 \
    KEEP_LATEST_FILES=1 \
    CLEANUP_MIN_AGE_SECONDS=300 \
    CLEANUP_INTERVAL=60 \
    DELETE_PROCESSED_CSI=false \
    RUN_PICOSCENES=false \
    PICOSCENES_COMMAND='PicoScenes "-d debug -i 2 --mode logger --plot"' \
    DRY_RUN=false \
    PROCESS_ONCE=false

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml setup.py picoscenes.pyx README.md LICENSE.md ./
COPY rxs_parsing_core ./rxs_parsing_core
COPY gmktec_csi_agent.py ./gmktec_csi_agent.py
COPY scripts/gmktec-entrypoint.sh /usr/local/bin/gmktec-entrypoint

RUN chmod +x /usr/local/bin/gmktec-entrypoint \
    && python -m pip install --upgrade pip setuptools wheel Cython numpy \
    && python -m pip install .

VOLUME ["/data/csi", "/picoscenes-installer"]

ENTRYPOINT ["/usr/local/bin/gmktec-entrypoint"]
